<Window x:Class="AppKeeper.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AppKeeper" Icon="Assets/AppKeeper.ico" WindowStyle="None" ResizeMode="CanResize"
        AllowsTransparency="True" Background="Transparent" ShowInTaskbar="True" Topmost="True"
        Width="820" Height="600" MinWidth="300" MinHeight="390"
        FontFamily="Segoe UI, Microsoft YaHei UI" Foreground="White" UseLayoutRounding="True"
        PreviewKeyDown="HandleKey" Closing="HideOnClose" StateChanged="UpdateWindowControls"
        AllowDrop="True" PreviewDragOver="RevealHomeForDrag" DragOver="WindowDragOver" Drop="WindowDrop">
    <Window.Resources>
        <Style x:Key="TileButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="3,4"/>
            <Setter Property="Margin" Value="2,1"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>
    <Border BorderBrush="#63A6C6DB" BorderThickness="1" CornerRadius="18">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#E4203951" Offset="0"/>
                <GradientStop Color="#EC232D44" Offset=".55"/>
                <GradientStop Color="#E92E2541" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>
        <Grid x:Name="Root" Margin="10,6,10,6">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <DockPanel Background="Transparent" Height="37" MouseLeftButtonDown="MoveWindow">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="−" Click="MinimizeWindow" ToolTip="最小化" AutomationProperties.Name="最小化" Padding="9,3"/>
                    <Button x:Name="MaximizeButton" Content="□" Click="ToggleMaximize" ToolTip="最大化" AutomationProperties.Name="最大化" Padding="9,3"/>
                    <Button Content="×" Click="HideClicked" ToolTip="隐藏" AutomationProperties.Name="隐藏" Padding="9,3"/>
                </StackPanel>
                <TextBlock Text="AppKeeper" VerticalAlignment="Center" Margin="8,0" FontWeight="SemiBold" IsHitTestVisible="False"/>
            </DockPanel>
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <StackPanel x:Name="PageRail" Margin="0,10,6,0">
                    <Button x:Name="AppsTab" Content="快捷应用" Click="OpenAppsPage" Padding="7,8" Margin="0,0,0,5"/>
                    <Button x:Name="PigeonTab" Content="飞鸽传书" Click="OpenPigeonPage" Padding="7,8" Margin="0,0,0,5"/>
                    <Button x:Name="AgendaTab" Content="日程管理" Click="OpenAgendaPage" Padding="7,8"/>
                </StackPanel>
                <ContentControl Grid.Column="1" x:Name="ModuleHost" Visibility="Collapsed" Margin="6,7,2,8"/>
                <Grid Grid.Column="1" x:Name="AppsPage">
            <Grid x:Name="Workspace" Margin="7,5,7,7">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid Height="33">
                    <TextBlock Text="快捷应用" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="AddButton" Content="＋" Click="OpenAdd" Padding="9,4" Margin="0,0,5,0"
                                ToolTip="添加入口" AutomationProperties.Name="添加入口"/>
                        <Button Content="&#xE713;" FontFamily="Segoe MDL2 Assets" Padding="9,4" Margin="0,0,5,0"
                                ToolTip="设置" AutomationProperties.Name="设置" Click="OpenSettings"/>
                    </StackPanel>
                </Grid>
                <Grid Grid.Row="1" Margin="0,7,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="132"/>
                        <ColumnDefinition Width="2*"/>
                    </Grid.ColumnDefinitions>
                    <Border x:Name="SearchFrame" CornerRadius="10" BorderBrush="#64B0CADF" BorderThickness="1" Background="#BC263A50">
                    <DockPanel MinHeight="44" Margin="7,0">
                        <TextBlock DockPanel.Dock="Left" Text="&#xE721;" FontFamily="Segoe MDL2 Assets" Margin="0,0,5,0"
                                   VerticalAlignment="Center" Foreground="{StaticResource Secondary}"/>
                        <Grid>
                            <TextBox x:Name="SearchBox" Style="{x:Null}" BorderThickness="0" Padding="0" FontSize="17"
                                     Background="Transparent" Foreground="White" CaretBrush="White" VerticalContentAlignment="Center"
                                     AutomationProperties.Name="搜索应用" MaxLength="256" TextChanged="SearchChanged"/>
                            <TextBlock x:Name="SearchHint" Text="搜索应用或拼音" FontSize="14" TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center" Foreground="{StaticResource Secondary}" IsHitTestVisible="False"/>
                        </Grid>
                    </DockPanel>
                    </Border>
                    <ScrollViewer Grid.Column="1" Margin="7,0,0,0" VerticalAlignment="Center"
                                  HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                                  AutomationProperties.Name="最近检索">
                        <StackPanel x:Name="SearchHistoryBar" Orientation="Horizontal"/>
                    </ScrollViewer>
                </Grid>
                <ScrollViewer Grid.Row="2" Margin="0,6,0,0" HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Disabled" AutomationProperties.Name="最近访问">
                    <StackPanel x:Name="RecentEntriesBar" Orientation="Horizontal"/>
                </ScrollViewer>
                <DockPanel Grid.Row="3" Margin="0,8,0,0" LastChildFill="True">
                    <Button Content="＋ 标签" Click="CreateTag" DockPanel.Dock="Right" Padding="8,4"
                            VerticalAlignment="Top" Margin="7,0,0,0"/>
                    <ScrollViewer x:Name="TagScroller" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="TagBar" Orientation="Horizontal" MinHeight="28"/>
                    </ScrollViewer>
                </DockPanel>
                <StackPanel Grid.Row="4" Margin="0,8,0,0" Orientation="Horizontal">
                    <Button x:Name="HomeButton" Content="应用" Click="OpenHome" Margin="0,0,6,0" Padding="11,5"/>
                    <Button x:Name="InboxButton" Content="待整理" Click="OpenInbox" Padding="11,5"/>
                </StackPanel>
                <Grid x:Name="TileArea" Grid.Row="5" Margin="0,6" Background="Transparent"
                      MouseLeftButtonDown="HideOnBlank"
                      SizeChanged="ResizeTiles" MouseWheel="WheelPage">
                    <UniformGrid x:Name="Tiles" VerticalAlignment="Center" HorizontalAlignment="Stretch"/>
                    <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False">
                        <TextBlock x:Name="EmptyTitle" TextAlignment="Center" FontSize="17" FontWeight="SemiBold"/>
                        <TextBlock x:Name="EmptyDetail" Margin="5,6" TextAlignment="Center" TextWrapping="Wrap"
                                   Foreground="{StaticResource Secondary}"/>
                    </StackPanel>
                </Grid>
                <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button x:Name="PreviousButton" Content="&#xE76B;" FontFamily="Segoe MDL2 Assets" Padding="9,5"
                            AutomationProperties.Name="上一页" Click="PreviousPage"/>
                    <TextBlock x:Name="PageLabel" VerticalAlignment="Center" Margin="11,0" Foreground="{StaticResource Secondary}"/>
                    <Button x:Name="NextButton" Content="&#xE76C;" FontFamily="Segoe MDL2 Assets" Padding="9,5"
                            AutomationProperties.Name="下一页" Click="NextPage"/>
                </StackPanel>
                <TextBlock Grid.Row="7" x:Name="StatusText" Foreground="{StaticResource Secondary}"
                           TextTrimming="CharacterEllipsis" Margin="0,7,10,0" FontSize="11"/>
            </Grid>
            <Grid x:Name="FolderShade" Visibility="Collapsed" Background="#630B1320" MouseLeftButtonDown="DismissFolder">
                <Border x:Name="FolderPanel" Background="#FA26394F" BorderBrush="#65AEC1D7" BorderThickness="1"
                        CornerRadius="15" HorizontalAlignment="Center" VerticalAlignment="Center" Width="535" Padding="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <DockPanel Margin="0,0,0,7">
                            <Button Content="×" Click="CloseFolder" DockPanel.Dock="Right" ToolTip="关闭文件夹"
                                    AutomationProperties.Name="关闭文件夹" Padding="9,4"/>
                            <TextBlock x:Name="FolderTitle" FontSize="17" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                        </DockPanel>
                        <ScrollViewer x:Name="FolderScroller" Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="300">
                            <UniformGrid x:Name="FolderTiles" Columns="4" VerticalAlignment="Top"/>
                        </ScrollViewer>
                        <Button Grid.Row="2" Content="拖到这里移出文件夹" AllowDrop="True" DragOver="OutDragOver" Drop="OutDrop"
                                Padding="8,5" Margin="0,7,0,0"/>
                    </Grid>
                </Border>
            </Grid>
                </Grid>
            </Grid>
            <Thumb x:Name="ResizeThumb" Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="17" Height="17" Cursor="SizeNWSE"
                   DragDelta="ResizeWindow" AutomationProperties.Name="调整窗口大小">
                <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                        <Grid Background="Transparent">
                            <Path Stroke="#92C7DCED" StrokeThickness="1" Data="M 5,13 L 13,5 M 9,13 L 13,9"
                                  IsHitTestVisible="False"/>
                        </Grid>
                    </ControlTemplate>
                </Thumb.Template>
            </Thumb>
        </Grid>
    </Border>
</Window>
