<?xml version="1.0" encoding="utf-8"?>
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap desktop rescap">
  <Identity Name="kangxls.EasyAppKeeper"
            Publisher="CN=2654BDB1-0B43-445A-95D6-6BD94EEA05B7"
            Version="1.3.1.0" ProcessorArchitecture="x64"/>
  <Properties>
    <DisplayName>EasyAppKeeper</DisplayName>
    <PublisherDisplayName>kangxls</PublisherDisplayName>
    <Description>Windows 快捷应用启动器，支持拼音搜索、标签和常用入口锁定。</Description>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>
  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19044.0" MaxVersionTested="10.0.26100.0"/>
  </Dependencies>
  <Resources>
    <Resource Language="zh-CN"/>
  </Resources>
  <Applications>
    <Application Id="EasyAppKeeper" Executable="AppKeeper.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements DisplayName="EasyAppKeeper" Description="Windows 快捷应用启动器"
                          BackgroundColor="transparent" Square44x44Logo="Assets\Square44x44.png"
                          Square150x150Logo="Assets\Square150x150.png"/>
      <Extensions>
        <desktop:Extension Category="windows.startupTask" Executable="EasyAppKeeper.Startup.exe"
                           EntryPoint="Windows.FullTrustApplication">
          <desktop:StartupTask TaskId="EasyAppKeeperStartup" Enabled="false" DisplayName="EasyAppKeeper"/>
        </desktop:Extension>
      </Extensions>
    </Application>
  </Applications>
  <Capabilities>
    <rescap:Capability Name="runFullTrust"/>
  </Capabilities>
</Package>
